---
import Layout from '../layouts/Layout.astro'
import site from '../content/site.json'

const services = [
  ['/napelem', 'service_1.png', 'Napelem', 'Napelemes rendszerek kivitelezése: tető- és földi elhelyezés, bármely méretben.'],
  ['/klima', 'service_3.png', 'Klíma', 'Hűtő-fűtő klímaberendezések értékesítése és igény szerinti telepítése.'],
  ['/auto-tolto', 'service_2.png', 'Autótöltő', 'Elektromos autók töltőrendszereinek értékesítése és igény szerinti telepítése.']
]
const references = [
  ['alveola_tiny.jpg', 'Alveola Kft. – Dunakeszi', 'Lapostetős tartószerkezet, optimalizált rendszer.', ['59.66 kWp teljesítmény', '157 db 380W-os napelem panel', '2 db 25kW-os inverter']],
  ['csoki_tile_tiny.jpg', 'Csoki Savaria Kft. – Szombathely', 'Trapézlemezes tartószerkezet, automata tűzeseti leválasztókkal.', ['57.4 kWp teljesítmény', '94 db 410W-os napelem panel', '4 db 15kW-os inverter']],
  ['tama_tiny.jpg', 'Tama Sütő Kft. – Siklós', 'Lapostetős tartószerkezet, optimalizált rendszer.', ['20.5 kWp teljesítmény', '50 db 410W-os napelem panel', '1 db 15kW-os inverter']],
  ['axxum_tile_tiny.jpg', 'AXXUM Packaging Hungary Kft. – Pécs', 'Lapostetős tartószerkezet, teljes energiamenedzsment rendszerrel.', ['59.04 kWp teljesítmény', '140 db 410W-os napelem panel', '1 db 50kW-os inverter']],
  ['agro_wein_tile_tiny.jpg', 'Agro-Wein Kft. – Kiskőrös', 'Földi tartószerkezet, bővítés előkészítéssel.', ['18.2 kWp teljesítmény', '40 db 455W-os napelem panel', '1 db 36kW-os inverter']]
]
const packages = [['/napelem', 'napelem_csomag_img.png', 'Napelem csomag', '01'], ['/klima', 'klima_csomag_img.png', 'Klíma csomag', '02'], ['/auto-tolto', 'autotolto_csomag_img.png', 'Autótöltő csomag', '03']]
const brands = ['brand_aux.png', 'brand_fronius.png', 'brand_midea.png', 'brand_solaredge.png', 'brand_solax.png', 'brand_wallbox.png', 'brand_besen_blue.png']
const stats = [['lakossagi.svg', '250+', 'Lakossági ügyfél'], ['talk2.svg', '70+', 'Vállalati ügyfél'], ['talk3.svg', '8 MW+', 'Teljesítmény'], ['hivatalos_forgalmazo.svg', '10 brand', 'Hivatalos forgalmazó']]
---
<Layout>
  <section class="banner-area banner-two-area"><div class="banner__right"><img src="/images/banner/banner_ver1.png" alt="Napelem rendszer" /></div><div class="banner-two__shape"><img src="/images/banner/banner-bg2.png" alt="" /></div><div class="container-fluid"><div class="banner__content banner-two__content hero-copy"><h1>Üdvözöljük a MentaSolarnál</h1><a href="#kapcsolat" class="btn-two mt-35">Árajánlat <i class="fa-solid fa-arrow-right ml-10"></i></a></div></div></section>

  <section id="szolgaltatasok" class="service-two pt-120 pb-120"><div class="service-two__bg sub-bg"></div><div class="container"><div class="section-header text-center mb-60 position-relative"><h5>Szolgáltatásaink</h5><h2>Használja fel a Nap erejét</h2></div><div class="row g-4">{services.map(([url, image, title, text], index) => <div class="col-xl-4 col-lg-4 col-md-6"><div class:list={['service-two__item', 'page-two', { active: index === 1 }]}><div class="icon"><img src={`/images/icon/${image}`} alt="" /></div><div class="content mt-30"><h4 class="mb-10"><a href={url} class="primary-hover">{title}</a></h4><p>{text}</p><a href={url} class="btn-three mt-30">Bővebben <i class="fa-solid fa-arrow-right ml-10"></i></a></div></div></div>)}</div></div></section>

  <section class="about-area choose-area"><div class="container"><div class="row g-4 align-items-center"><div class="col-lg-6"><div class="image"><img class="radius10" src="/images/choose/choose_ver3.png" alt="Tervezés" /></div></div><div class="col-lg-6"><div class="choose__item"><div class="section-header"><h5>Miért válassza a MentaSolart?</h5><h2>Önnek tervezünk</h2><p>Nálunk nincs rossz kérdés. Mindent szívesen elmagyarázunk és kiemelten figyelünk arra, hogy a tervezéssel teljesítsük igényeit.</p></div><div class="choose__content"><ul class="choose-info mt-40 pb-20"><li><div class="icon"><img src="/images/icon/gloob.png" alt="" /></div><p>A legmodernebb eszközök beépítésével garantáltan csökkenti energiafogyasztását és hozzájárul a zöldebb környezethez.</p></li></ul><div class="about__content"><ul><li><i class="fa-solid fa-check"></i>Kiterjesztett garancia</li><li><i class="fa-solid fa-check"></i>Könnyen bővíthető rendszerek</li><li><i class="fa-solid fa-check"></i>Távfelügyelet</li></ul></div></div></div></div></div></div></section>

  <section class="gallery-area gallery-two-area pb-120 overflow-hidden"><div class="container-fluid p-0"><div class="section-header text-center mb-60"><h5>Referenciáink</h5><h2>Néhány kiemelt munkánk, helyszíni megtekinthetőséggel</h2></div><div class="gallery__item"><div class="swiper gallery__slider"><div class="swiper-wrapper">{references.map(([image, title, description, details]) => <div class="swiper-slide"><div class="image gallery__image gallery-two__image"><img class="radius10" src={`/images/gallery/${image}`} alt={title} /><div class="image-content"><h4><span class="primary-hover">{title}</span></h4><span>{description}</span><br />{details.map(detail => <>{detail}<br /></>)}</div></div></div>)}</div></div><div class="dot-wrp mt-50 text-center"><div class="dot gallery__dot"></div></div></div></div></section>

  <section id="kapcsolat" class="talk-us-area pb-120"><div class="container talk-us__container"><div class="row g-4"><div class="col-lg-6"><div class="talk-us__left"><div class="section-header"><h5>Beszéljünk!</h5><h2>Forduljon hozzánk bizalommal!</h2><p>Segítünk áttérni zöld energiára! Vegye fel velünk a kapcsolatot egy ingyenes konzultációért, és fedezze fel, hogyan segíthet Önnek a MentaSolar.</p></div><div class="talk-us__wrp mt-60"><div class="row g-4">{stats.map(([icon, value, label]) => <div class="col-6"><div class="talk-us__item"><div class="icon"><img src={`/images/icon/${icon}`} alt="" style="max-width: 65px; max-height: 65px;" /></div><div class="content"><h2>{value}</h2><p>{label}</p></div></div></div>)}</div></div></div></div><div class="col-lg-6"><div class="subscribe__item talk-us__now"><form name="kapcsolat" method="POST" data-netlify="true" netlify-honeypot="bot-field"><input type="hidden" name="form-name" value="kapcsolat" /><p class="d-none"><label>Ne töltse ki: <input name="bot-field" /></label></p><div class="row"><div class="col-sm-6"><input name="nev" required placeholder="Név" /></div><div class="col-sm-6"><input name="email" type="email" required placeholder="Email cím" /></div></div><div class="row"><div class="col-sm-6"><input name="telefon" placeholder="Telefonszám" /></div><div class="col-sm-6"><select name="erdeklodes"><option value="">Mi érdekli?</option><option>Napelem</option><option>Klíma</option><option>Autótöltő</option></select></div></div><textarea name="uzenet" required placeholder="Írja meg üzenetét.." style="height: 250px;"></textarea><button>Üzenet küldése</button></form></div></div></div></div></section>

  <section class="process-area"><div class="container"><div class="section-header text-center mb-60"><h5>Ajánlatok</h5><h2>Kiemelt csomagajánlatok</h2></div><div class="row g-4">{packages.map(([url, image, title, number]) => <div class="col-lg-4 col-md-6"><a href={url} class="process__item border d-block"><div class="image"><img src={`/images/home/${image}`} alt={title} /></div><div class="process__content"><h4>{title}</h4><h3>{number}</h3></div></a></div>)}</div></div></section>

  <div class="brand-area pb-100 brand-two-area"><div class="container"><div class="swiper brand__slider"><div class="swiper-wrapper">{brands.map(brand => <div class="swiper-slide"><img src={`/images/brand/${brand}`} alt="Partner" /></div>)}</div></div></div></div>

  <section class="testimonial-area testimonial-tow-area testimonials-compact secondary-bg pt-120 pb-120 bg-image" data-background="/images/bg/testimonial-bg2.png"><div class="container"><div class="row g-4 align-items-center"><div class="col-lg-8 offset-lg-2"><div class="swiper testimonial__slider"><div class="swiper-wrapper"><div class="swiper-slide"><div class="testimonial-two__item"><div class="coma"><i class="fa-thin fa-quote-right"></i></div><div class="testimonial-two__content"><div class="d-flex align-items-center"><div class="user"><img src="/images/testimonial/pilk_logo_small.png" alt="PilkPress" /></div><div class="infot"><h4>PilkPress Kft.</h4><span>Tilli Tamás – tulajdonos</span></div></div><p class="mt-30">Csináld magad módszerrel építettünk egy kis, sziget üzemű rendszert a MentaSolar munkatársainak felkészítése alapján. Hibátlanul működik!</p></div></div></div><div class="swiper-slide"><div class="testimonial-two__item"><div class="coma"><i class="fa-thin fa-quote-right"></i></div><div class="testimonial-two__content"><div class="d-flex align-items-center"><div class="user"><img src="/images/testimonial/saving_energy_small.png" alt="Saving Energy" /></div><div class="infot"><h4>Saving Energy Kft.</h4><span>Szabó Olivér – tulajdonos</span></div></div><p class="mt-30">Nagyon jól használhatók a saját márkás tartószerkezeti rendszereik. Ajánlom őket beszállítóként is!</p></div></div></div></div></div></div></div></div></section>
</Layout>
