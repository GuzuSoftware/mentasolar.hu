---
import Layout from '../layouts/Layout.astro'
import site from '../content/site.json'
const references = [
  ['alveola_tiny.jpg', 'Alveola Kft. – Dunakeszi', 'Lapostetős tartószerkezet, optimalizált rendszer.', '59.66 kWp teljesítmény'],
  ['csoki_tile_tiny.jpg', 'Csoki Savaria Kft. – Szombathely', 'Trapézlemezes tartószerkezet, automata tűzeseti leválasztókkal.', '57.4 kWp teljesítmény'],
  ['tama_tiny.jpg', 'Tama Sütő Kft. – Siklós', 'Lapostetős tartószerkezet, optimalizált rendszer.', '20.5 kWp teljesítmény'],
  ['axxum_tile_tiny.jpg', 'AXXUM Packaging Hungary Kft. – Pécs', 'Lapostetős tartószerkezet, teljes energiamenedzsment rendszerrel.', '59.04 kWp teljesítmény'],
  ['agro_wein_tile_tiny.jpg', 'Agro-Wein Kft. – Kiskőrös', 'Földi tartószerkezet, bővítés előkészítéssel.', '18.2 kWp teljesítmény']
]
---
<Layout>
  <section class="banner-two-area"><div class="container"><div class="banner-two__wrp"><div class="banner-two__content"><h5 class="wow fadeInUp">{site.heroEyebrow}</h5><h1 class="wow fadeInUp" data-wow-delay=".2s">{site.heroTitle}</h1><p class="wow fadeInUp" data-wow-delay=".4s">{site.heroText}</p><a href="/kapcsolat" class="btn-two mt-35">Árajánlat <i class="fa-solid fa-arrow-right"></i></a></div><div class="banner-two__image"><img src="/images/banner/banner_ver1.png" alt="Napelem rendszer" /></div></div></div><img class="banner-two__shape" src="/images/banner/banner-bg2.png" alt="" /></section>
  <section class="service-two-area pt-120 pb-120"><div class="container"><div class="section-header text-center mb-60"><h5>Szolgáltatásaink</h5><h2>Komplett energetikai megoldások</h2></div><div class="row g-4"><div class="col-md-4"><a class="service-two__item d-block" href="/napelem"><img src="/images/icon/service_1.png" alt="" /><h3>Napelem</h3><p>Napelemes rendszerek kivitelezése tető- és földi elhelyezéssel, bármely méretben.</p><span>Bővebben <i class="fa-solid fa-arrow-right"></i></span></a></div><div class="col-md-4"><a class="service-two__item d-block" href="/auto-tolto"><img src="/images/icon/service_2.png" alt="" /><h3>Autótöltő</h3><p>Elektromos autók töltőrendszereinek értékesítése és igény szerinti telepítése.</p><span>Bővebben <i class="fa-solid fa-arrow-right"></i></span></a></div><div class="col-md-4"><a class="service-two__item d-block" href="/klima"><img src="/images/icon/service_3.png" alt="" /><h3>Klíma</h3><p>Hűtő-fűtő klímaberendezések értékesítése és igény szerinti telepítése.</p><span>Bővebben <i class="fa-solid fa-arrow-right"></i></span></a></div></div></div></section>
  <section class="choose-area pb-120"><div class="container"><div class="row g-5 align-items-center"><div class="col-lg-6"><img class="radius10" src="/images/choose/choose_ver3.png" alt="MentaSolar" /></div><div class="col-lg-6"><div class="section-header"><h5>Miért válassza a MentaSolart?</h5><h2>Önnek tervezünk</h2></div><p>Nálunk nincs rossz kérdés. Mindent szívesen elmagyarázunk és kiemelten figyelünk arra, hogy a tervezéssel teljesítsük igényeit.</p><ul class="mt-25"><li>Kiterjesztett garancia</li><li>Könnyen bővíthető rendszerek</li><li>Távfelügyelet</li></ul></div></div></div></section>
  <section class="project-area secondary-bg pt-120 pb-120"><div class="container"><div class="section-header text-center mb-60"><h5>Referenciáink</h5><h2>Néhány kiemelt munkánk</h2></div><div class="row g-4">{references.map(([image, title, text, metric]) => <div class="col-md-6 col-lg"><article class="project__item h-100"><img class="w-100 radius10" src={`/images/gallery/${image}`} alt={title} /><div class="pt-20"><h4>{title}</h4><p>{text}</p><strong>{metric}</strong></div></article></div>)}</div></div></section>
  <section class="contact-two-area pt-120 pb-120"><div class="container"><div class="row g-5"><div class="col-lg-5"><div class="section-header"><h5>Beszéljünk!</h5><h2>Forduljon hozzánk bizalommal!</h2></div><p>Segítünk áttérni zöld energiára. Vegye fel velünk a kapcsolatot egy ingyenes konzultációért.</p><p><a href={`tel:${site.phone.replaceAll(' ', '')}`}>{site.phone}</a><br /><a href={`mailto:${site.email}`}>{site.email}</a></p></div><div class="col-lg-7"><form name="kapcsolat" method="POST" data-netlify="true" netlify-honeypot="bot-field" class="contact__form"><input type="hidden" name="form-name" value="kapcsolat" /><p class="d-none"><label>Ne töltse ki: <input name="bot-field" /></label></p><div class="row g-3"><div class="col-md-6"><input name="nev" required placeholder="Név" /></div><div class="col-md-6"><input name="email" type="email" required placeholder="Email cím" /></div><div class="col-md-6"><input name="telefon" placeholder="Telefonszám" /></div><div class="col-md-6"><select name="erdeklodes"><option value="">Miben segíthetünk?</option><option>Napelem</option><option>Autótöltő</option><option>Klíma</option></select></div><div class="col-12"><textarea name="uzenet" required placeholder="Üzenet"></textarea></div><div class="col-12"><button class="btn-two" type="submit">Üzenet küldése <i class="fa-solid fa-arrow-right"></i></button></div></div></form></div></div></div></section>
</Layout>
