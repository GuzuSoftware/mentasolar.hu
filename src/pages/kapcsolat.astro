---
import Layout from '../layouts/Layout.astro'
import site from '../content/site.json'
---
<Layout title="Kapcsolat | MentaSolar"><section class="page-banner-area"><div class="container"><div class="page-banner__content"><h1>Kapcsolat</h1><a href="/">Kezdőlap</a> / Kapcsolat</div></div></section><section class="contact-area pt-120 pb-120"><div class="container"><div class="row g-5"><div class="col-lg-5"><h2>Vegye fel velünk a kapcsolatot!</h2><p class="mt-25"><a href={`tel:${site.phone.replaceAll(' ', '')}`}>{site.phone}</a><br /><a href={`mailto:${site.email}`}>{site.email}</a><br />{site.address}</p><iframe title="MentaSolar térkép" src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d1163.5816758472527!2d18.258503228969264!3d46.08142448925324!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x4742b97e38f2a6c9%3A0x5ed47f261443508b!2sP%C3%A9cs%2C%20Moh%C3%A1csi%20%C3%BAt%201!5e0!3m2!1shu!2shu!4v1710000000000" width="100%" height="260" loading="lazy"></iframe></div><div class="col-lg-7"><form name="kapcsolat" method="POST" data-netlify="true" netlify-honeypot="bot-field" class="contact__form"><input type="hidden" name="form-name" value="kapcsolat" /><p class="d-none"><label>Ne töltse ki: <input name="bot-field" /></label></p><input name="nev" required placeholder="Név" /><input name="email" type="email" required placeholder="Email cím" /><input name="telefon" placeholder="Telefonszám" /><textarea name="uzenet" required placeholder="Üzenet"></textarea><button class="btn-two" type="submit">Üzenet küldése</button></form></div></div></div></section></Layout>
