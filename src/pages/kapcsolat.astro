---
import Layout from '../layouts/Layout.astro'
import site from '../content/site.json'
---

<Layout seo={site.contactSeo} breadcrumbs={[{ name: 'Kezdőlap', url: '/' }, { name: 'Kapcsolat', url: '/kapcsolat' }]}>
  <section class="contact-area pt-120 pb-120">
    <div class="container">
      <div class="contact-page__intro text-center">
        <h1 class="contact-page__title">{site.contactHeading}</h1>
        <p>{site.contactIntro}</p>
      </div>
      <div class="row g-4">
        <div class="col-lg-6">
          <div class="contact__item bor radius10">
            <div class="p-4 bor-bottom">
              <div class="row g-4">
                <div class="col-sm-6">
                  <div class="contact__content bor-right">
                    <div class="icon mb-20"><i class="fa-solid fa-phone" aria-hidden="true"></i></div>
                    <h4 class="text-capitalize">Telefonszám</h4>
                    <a href={`tel:${site.phone.replaceAll(' ', '')}`}>{site.phone}</a>
                  </div>
                </div>
                <div class="col-sm-6">
                  <div class="contact__content">
                    <div class="icon mb-20"><i class="fa-solid fa-envelope" aria-hidden="true"></i></div>
                    <h4 class="text-capitalize contact-email-label">E-mail cím</h4>
                    <a href={`mailto:${site.email}`}>{site.email}</a>
                  </div>
                </div>
              </div>
            </div>
          </div>
          <aside class="contact-webshop-cta mt-25" aria-label="Helyszíni felmérés">
            <h3>Helyszíni felmérés</h3>
            <p>Kérje ingyenes helyszíni felmérésünket, hogy valós felhasználói igényeire szabott tervet készíthessünk.</p>
          </aside>
        </div>
        <div class="col-lg-6">
          <div class="subscribe__item contact__form">
            <h5 class="text-uppercase pb-10 mb-10">Üzenjen nekünk</h5>
            <h2 class="mb-20">Küldjön üzenetet</h2>
            <form name="kapcsolat" method="POST" data-netlify="true" netlify-honeypot="bot-field">
              <input type="hidden" name="form-name" value="kapcsolat" />
              <input type="hidden" name="ajanlat-azonosito" value="" />
              <p class="d-none"><label>Ne töltse ki: <input name="bot-field" /></label></p>
              <input name="nev" required placeholder="Az Ön neve" />
              <input name="email" type="email" required placeholder="Az Ön email címe" />
              <input name="telefon" placeholder="Az Ön telefonszáma" />
              <textarea name="uzenet" required placeholder="Írjon üzenetet..."></textarea>
              <button type="submit">Üzenet küldése</button>
            </form>
            <p class="form-privacy-note">Az űrlap adatkezelési részletei az <a href="/adatkezeles">Adatkezelési tájékoztatóban</a> olvashatók.</p>
          </div>
        </div>
      </div>
    </div>
  </section>
  <script is:inline>
    const search = new URLSearchParams(window.location.search);
    const offer = search.get('ajanlat');
    const offerId = search.get('ajanlatId');
    const message = document.querySelector('textarea[name="uzenet"]');
    const offerField = document.querySelector('input[name="ajanlat-azonosito"]');
    if (offer && message && !message.value) message.value = `A(z) „${offer}” csomag iránt érdeklődöm. Kérem, vegyék fel velem a kapcsolatot.`;
    if (offerId && offerField) offerField.value = offerId;
  </script>
</Layout>
