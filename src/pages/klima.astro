---
import Layout from '../layouts/Layout.astro'
import SolarPageBanner from '../components/SolarPageBanner.astro'
import ClimateOfferGrid from '../components/ClimateOfferGrid.astro'
import climate from '../content/climate.json'
---

<Layout seo={climate.seo} breadcrumbs={[{ name: 'Kezdőlap', url: '/' }, { name: 'Klíma', url: '/klima' }]}>
  <SolarPageBanner title={climate.pageTitle} subtitle={climate.heroSubtitle} breadcrumb="Klíma" />
  <section class="climate-offer-page pt-120 pb-120"><div class="container"><ClimateOfferGrid intro={climate.offerIntro} /><div class="solar-offer-page__intro solar-service-seo-intro"><h2>{climate.infoTitle}</h2>{climate.intro.map((paragraph) => <p>{paragraph}</p>)}</div></div></section>
</Layout>
