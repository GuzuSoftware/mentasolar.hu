---
import Layout from '../layouts/Layout.astro'
import SolarPageBanner from '../components/SolarPageBanner.astro'
import ChargerOfferGrid from '../components/ChargerOfferGrid.astro'
import charger from '../content/charger.json'
---

<Layout seo={charger.seo} breadcrumbs={[{ name: 'Kezdőlap', url: '/' }, { name: 'Autótöltő', url: '/auto-tolto' }]}>
  <SolarPageBanner title={charger.pageTitle} subtitle={charger.heroSubtitle} breadcrumb="Autótöltő" />
  <section class="charger-offer-page pt-120 pb-120"><div class="container"><ChargerOfferGrid intro={charger.offerIntro} /><div class="solar-offer-page__intro solar-service-seo-intro"><h2>{charger.infoTitle}</h2>{charger.intro.map((paragraph) => <p>{paragraph}</p>)}</div></div></section>
</Layout>
