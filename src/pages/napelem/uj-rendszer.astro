---
import Layout from '../../layouts/Layout.astro'
import SolarOfferFinder from '../../components/SolarOfferFinder.astro'
import SolarPageBanner from '../../components/SolarPageBanner.astro'
import solar from '../../content/solar.json'
---

<Layout seo={solar.newSystemSeo} breadcrumbs={[{ name: 'Kezdőlap', url: '/' }, { name: 'Napelem', url: '/napelem' }, { name: 'Új rendszer', url: '/napelem/uj-rendszer' }]}>
  <SolarPageBanner title={solar.newSystemTitle} subtitle={solar.newSystemHeroSubtitle} breadcrumb="Új rendszer" />
  <section class="solar-offer-page solar-offer-page--new-system pt-120 pb-120"><div class="container"><SolarOfferFinder kind="new-system" defaultSystemType={solar.defaultSystemType} defaultStorageType={solar.defaultStorageType} /><div class="solar-offer-page__intro solar-service-seo-intro"><h2>{solar.newSystemInfoTitle}</h2>{solar.newSystemIntro.map((paragraph) => <p>{paragraph}</p>)}</div></div></section>
</Layout>
