---
import Layout from '../../layouts/Layout.astro'
import SolarOfferFinder from '../../components/SolarOfferFinder.astro'
import SolarPageBanner from '../../components/SolarPageBanner.astro'
import solar from '../../content/solar.json'
---

<Layout title={solar.seoTitle} description={solar.seoDescription}>
  <SolarPageBanner title="Új napelemes rendszer" breadcrumb="Új rendszer" />
  <section class="solar-offer-page solar-offer-page--new-system pt-120 pb-120"><div class="container"><SolarOfferFinder kind="new-system" defaultSystemType={solar.defaultSystemType} defaultStorageType={solar.defaultStorageType} /></div></section>
</Layout>
