---
import Layout from '../layouts/Layout.astro'
import site from '../content/site.json'

type Faq = { question: string; answer: string; order: number }
const faqModules = import.meta.glob<{ default: Faq }>('../data/faqs/*.json', { eager: true })
const faqs = Object.values(faqModules)
  .map(({ default: faq }) => faq)
  .sort((first, second) => first.order - second.order || first.question.localeCompare(second.question, 'hu'))
---

<Layout seo={site.faqSeo} breadcrumbs={[{ name: 'Kezdőlap', url: '/' }, { name: 'GYIK', url: '/gyik' }]}>
  <section class="faq-two-area pt-120 pb-120">
    <div class="container">
      <h1 class="faq-page__title mb-60 text-center">{site.faqHeading}</h1>

      <div class="faq-two__item">
        <div class="accordion" id="faqAccordion">
          {faqs.map((faq, index) => {
            const headingId = `faq-heading-${index}`
            const collapseId = `faq-collapse-${index}`
            const isOpen = index === 0

            return (
              <div class="accordion-item">
                <h2 class="accordion-header" id={headingId}>
                  <button
                    class:list={['accordion-button', { collapsed: !isOpen }]}
                    type="button"
                    data-bs-toggle="collapse"
                    data-bs-target={`#${collapseId}`}
                    aria-expanded={isOpen ? 'true' : 'false'}
                    aria-controls={collapseId}
                  >
                    {faq.question}
                  </button>
                </h2>
                <div
                  id={collapseId}
                  class:list={['accordion-collapse', 'collapse', { show: isOpen }]}
                  aria-labelledby={headingId}
                  data-bs-parent="#faqAccordion"
                >
                  <div class="accordion-body"><p>{faq.answer}</p></div>
                </div>
              </div>
            )
          })}
        </div>
      </div>
    </div>
  </section>
</Layout>
