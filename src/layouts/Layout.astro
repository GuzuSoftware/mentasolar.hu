---
import site from '../content/site.json'
interface Props { title?: string; description?: string }
const { title = 'MentaSolar – Napelem és Klíma Megoldások', description = 'Professzionális napelem- és klímamegoldások.' } = Astro.props
---
<!doctype html>
<html lang="hu">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <link rel="icon" href="/images/favicon.png" />
    <link rel="stylesheet" href="/css/bootstrap.min.css" />
    <link rel="stylesheet" href="/css/all.min.css" />
    <link rel="stylesheet" href="/css/meanmenu.css" />
    <link rel="stylesheet" href="/css/swiper-bundle.min.css" />
    <link rel="stylesheet" href="/css/magnific-popup.css" />
    <link rel="stylesheet" href="/css/animate.css" />
    <link rel="stylesheet" href="/css/nice-select.css" />
    <link rel="stylesheet" href="/css/style.css" />
    <title>{title}</title>
  </head>
  <body>
    <div class="header-top d-none d-lg-block"><div class="container"><div class="header-top-wrp"><ul class="info"><li><i class="fa-solid fa-paper-plane"></i> <a href={`mailto:${site.email}`}>{site.email}</a></li><li class="bor-left ms-4 ps-4"><i class="fa-solid fa-location-dot"></i> {site.address}</li></ul><ul class="link-info"><li class="bor-right"><a href={site.facebook} aria-label="Facebook"><i class="fa-brands fa-facebook-f"></i></a></li><li><a href={site.instagram} aria-label="Instagram"><i class="fa-brands fa-instagram"></i></a></li></ul></div></div></div>
    <header class="header-area">
      <div class="container">
        <div class="header__main">
          <a href="/" class="logo"><img src="/images/logo/mentasolar_logo_horizontal.svg" alt="MentaSolar" /></a>
          <div class="main-menu"><nav><ul><li><a href="/">Kezdőlap</a></li><li><a href="/napelem">Napelem</a></li><li><a href="/klima">Klíma</a></li><li><a href="/gyik">GYIK</a></li><li><a href="/kapcsolat">Kapcsolat</a></li></ul></nav></div>
          <button class="mobile-nav-toggle d-block d-lg-none" type="button" aria-controls="mobile-navigation" aria-expanded="false" aria-label="Navigáció megnyitása"><i class="fa-solid fa-bars" aria-hidden="true"></i></button>
        </div>
      </div>
      <button class="mobile-navigation-backdrop" type="button" aria-label="Navigáció bezárása" hidden></button>
      <div class="mobile-navigation" id="mobile-navigation" hidden>
        <div class="container"><nav aria-label="Mobil navigáció"><ul><li><a href="/">Kezdőlap</a></li><li><a href="/napelem">Napelem</a></li><li><a href="/klima">Klíma</a></li><li><a href="/gyik">GYIK</a></li><li><a href="/kapcsolat">Kapcsolat</a></li></ul></nav><div class="mobile-navigation__contact" aria-label="Elérhetőségek"><a href={`tel:${site.phone.replaceAll(' ', '')}`}><i class="fa-solid fa-phone" aria-hidden="true"></i><span>{site.phone}</span></a><a href={`mailto:${site.email}`}><i class="fa-solid fa-envelope" aria-hidden="true"></i><span>{site.email}</span></a><a href="https://maps.google.com/?q=46.081515,18.259501" target="_blank" rel="noreferrer"><i class="fa-solid fa-location-dot" aria-hidden="true"></i><span>{site.address}</span></a></div></div>
      </div>
    </header>
    <script is:inline>
      const mobileNavigation = document.querySelector('#mobile-navigation');
      const mobileNavigationBackdrop = document.querySelector('.mobile-navigation-backdrop');
      const mobileNavToggle = document.querySelector('.mobile-nav-toggle');
      const closeMobileNavigation = () => { mobileNavigation.hidden = true; mobileNavigationBackdrop.hidden = true; mobileNavToggle.setAttribute('aria-expanded', 'false'); mobileNavToggle.setAttribute('aria-label', 'Navigáció megnyitása'); mobileNavToggle.querySelector('i').className = 'fa-solid fa-bars'; };
      mobileNavToggle?.addEventListener('click', () => { const isOpen = mobileNavToggle.getAttribute('aria-expanded') === 'true'; mobileNavigation.hidden = isOpen; mobileNavigationBackdrop.hidden = isOpen; mobileNavToggle.setAttribute('aria-expanded', String(!isOpen)); mobileNavToggle.setAttribute('aria-label', isOpen ? 'Navigáció megnyitása' : 'Navigáció bezárása'); mobileNavToggle.querySelector('i').className = isOpen ? 'fa-solid fa-bars' : 'fa-solid fa-xmark'; });
      mobileNavigationBackdrop?.addEventListener('click', closeMobileNavigation);
      document.addEventListener('click', (event) => { if (!mobileNavigation.hidden && !mobileNavigation.contains(event.target) && !mobileNavToggle.contains(event.target)) closeMobileNavigation(); });
      window.addEventListener('resize', () => { if (window.innerWidth >= 992 && !mobileNavigation.hidden) closeMobileNavigation(); });
    </script>
    <main><slot /></main>
    <footer class="footer-area"><div class="footer__bg"></div><div class="container"><div class="footer__wrp pt-80 pb-80"><div class="row g-4"><div class="col-lg-3 col-md-6"><div class="footer__item"><div class="logo"><a class="d-block" href="/"><img src="/images/logo/mentasolar_logo_horizontal.svg" alt="MentaSolar" /></a></div><p class="mt-30 black-para">MentaSolar – Használja fel a Nap erejét!</p><div class="social-icons mt-30"><a href={site.facebook} aria-label="Facebook"><i class="fa-brands fa-facebook-f"></i></a><a href={site.instagram} aria-label="Instagram"><i class="fa-brands fa-instagram"></i></a></div></div></div><div class="col-lg-1 d-none d-lg-block"></div><div class="col-lg-2 col-md-6"><div class="footer__item service"><h4 class="text-white mb-30">Szolgáltatások</h4><ul><li class="mb-15"><a href="/napelem"><i class="fa-solid fa-angle-right"></i> Napelem</a></li><li class="mb-15"><a href="/klima"><i class="fa-solid fa-angle-right"></i> Klíma</a></li></ul></div></div><div class="col-lg-3 col-md-6"><div class="footer__item find"><h4 class="text-white mb-30">Kapcsolat</h4><ul><li class="mb-20"><a href="https://maps.google.com/?q=46.081515,18.259501" target="_blank"><i class="fa-solid fa-circle pr-10"></i> {site.address}</a></li><li class="mb-20"><a href={`tel:${site.phone.replaceAll(' ', '')}`}><i class="fa-solid fa-circle pr-10"></i>{site.phone}</a></li><li><a href={`mailto:${site.email}`}><i class="fa-solid fa-circle pr-10"></i>{site.email}</a></li></ul></div></div></div></div></div><div class="footer__copy-text"><div class="container"><div class="d-flex copy-text align-items-center justify-content-between"><p>© {new Date().getFullYear()} MentaSolar – Vision Manager Zrt. Minden jog fenntartva!</p><ul><li><a href="/kapcsolat" class="primary-hover">Kapcsolat</a></li></ul></div></div></div></footer>
    <script is:inline src="/js/jquery-3.7.1.min.js"></script><script is:inline src="/js/bootstrap.min.js"></script><script is:inline src="/js/jquery.meanmenu.js"></script><script is:inline src="/js/swiper-bundle.min.js"></script><script is:inline src="/js/jquery.counterup.min.js"></script><script is:inline src="/js/wow.min.js"></script><script is:inline src="/js/magnific-popup.min.js"></script><script is:inline src="/js/nice-select.min.js"></script><script is:inline src="/js/isotope.pkgd.min.js"></script><script is:inline src="/js/jquery.waypoints.js"></script><script is:inline src="/js/script.js"></script>
  </body>
</html>
